   "source": [
    "function isPositiveAndEven(num) {\n",
    "  let isPositive = num > 0;        \n",
    "  let isEven = num % 2 === 0;           \n",
    "}\n",
    "\n",
    "// Test it with an input of 8\n",
    "let testNum = 8;\n",
    "\n",
    "console.log(\"Testing number:\", testNum);\n",
    "console.log(\"Is it positive?\", testNum > 0);\n",
    "console.log(\"Is it even?\", testNum % 2 === 0);"
   ]
  }
